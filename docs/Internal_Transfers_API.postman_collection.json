		{
			"name": "Transaction Processing",
			"item": [
				{
					"name": "Submit Transaction - Standard",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response contains transaction details\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('transaction_id');",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData).to.have.property('message');",
									"});",
									"",
									"pm.test(\"Transaction status is completed\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('completed');",
									"});",
									"",
									"pm.test(\"Transaction ID is a positive integer\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.transaction_id).to.be.a('number');",
									"    pm.expect(jsonData.transaction_id).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
